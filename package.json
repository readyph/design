{
  "name": "readyph-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "ReadyPH design system — React components, tokens, Tailwind preset and theme.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "tokens": "npm run generate -w @readyph/ui",
    "storybook": "npm run storybook -w @readyph/ui",
    "build-storybook": "npm run build-storybook -w @readyph/ui",
    "build": "npm run build -w @readyph/ui",
    "type-check": "npm run type-check -w @readyph/ui",
    "test": "npm run test -w @readyph/ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "overrides": {
    "human-id": "4.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "~5.9.3"
  }
}
